# ─────────────────────────────────────────────────────────────────
# Kindo Frontend — Environment Variables
# Copy this file to .env and fill in the values for local dev.
# In Cloudflare Pages: set these in Settings → Environment variables.
# ─────────────────────────────────────────────────────────────────

# URL of your deployed Cloudflare Worker (no trailing slash)
VITE_WORKER_URL=https://kindo-upload-worker.YOUR-SUBDOMAIN.workers.dev

# Admin panel password (change before going live!)
VITE_ADMIN_PASSWORD=kindo2024

# ─────────────────────────────────────────────────────────────────
# The variables below are for the WORKER (set via `wrangler secret put`)
# Do NOT put them here or in any committed file.
# ─────────────────────────────────────────────────────────────────
# R2_PUBLIC_URL=https://pub-943bd5d0ce6f4df9b0b9cbc05bec9e54.r2.dev
